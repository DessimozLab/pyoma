#
#  to be called with a given genome, it's database dbpath
#

if not assigned(dbpath) or not assigned(genome)or not assigned(tot_entries) or not assigned(tot_aa) then
    printf('not all input arguments are assigned: %A, %A, %A %A\n', dbpath, genome, tot_entries, tot_aa);
    exit(1);
fi:
if not assigned(outdir) then outdir := './' fi:
CallSystem('mkdir -p '.outdir);

ReadDb(dbpath);
if DB['TotEntries'] <> tot_entries or DB['TotAA'] <> tot_aa then
    printf('Database seems corrupted\n');
    exit(1):
fi:

convert_loc := proc(s)
    if type(s, posint..posint) then
        return([s[1], s[2], 1]);
    elif type(s, complement(anything)) then
        r := procname(s[1]);
        r[-1] := -1*r[-1];
        return(r);
    elif type(s, structure(anything, join)) then
        r := [seq(procname(s[i]), i=1..length(s))];
        return(r);
    elif type(s, posint..After(posint)) then
        return([s[1], s[2,1], 1]);
    elif type(s, Before(posint)..posint) then
        return([s[1,1], s[2], 1]);
    elif type(s, Before(posint)..After(posint)) then
        return([s[1,1], s[2,1], 1]);
    elif type(s, FromElsewhere(string,posint..posint)) then
        return([s[2,1], s[2,2], 1]);
    elif type(s, posint) then
        return([s, s, 1]);
    else
        error('unexpected locus tag: '. string(s));
    fi:
end:

tab:= table():
tab['seqs'] := [seq(Sequence(Entry(i)), i=1..tot_entries)]:
tab['cdna'] := [seq(SearchTag('DNA', Entry(i)), i=1..tot_entries)]:
tab['chrs'] := [seq(SearchTag('CHR',Entry(i)), i=1..tot_entries)];
locs := []:
for i to tot_entries do
    r := convert_loc(parse(SearchTag('LOC',Entry(i))));
    if not type(r, matrix) then r := [r] fi:
    locs := append(locs, r):
od:
tab['locs'] := locs:
tab['ids'] := [seq(SearchDelim('; ', SearchTag('ID', Entry(i)))[1], i=1..tot_entries)];
tab['acs'] := [seq(SearchDelim('; ', SearchTag('AC', Entry(i))), i=1..tot_entries)];
tab['de'] := [seq(SearchTag('DE', Entry(i)), i=1..tot_entries)];

if is_polyploid = 'true' then
    err := traperror(ReadProgram(subgenome_path));
    if err=lasterror then
        error('cannot load subgenome file from '.subgenome_path);
    fi:
    subg := SubGenome[genome]: nams := SubNames[genome]:
    dat := CreateString(tot_entries):
    for k to length(subg) do for sg in subg[k] do
        dat[sg[1]] := nams[k]:
    od od:
    tab['subgenome'] := dat:
fi:

Set(printgc=false);
OpenWriting(outdir.'/'.genome.'.json');
prints(json(tab)):
OpenWriting(previous):
