    #fi:
#tab['ogs'] := [seq(parse(SearchTag('OG',Entry(Goff[gNr]+i))), i=1..GS[g,tot_entries])]:

Set(printgc=false);
OpenWriting(outdir.'/'.genome.'.json');
prints(json(tab)):
OpenWriting(previous):
